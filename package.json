{
  "name": "karat",
  "private": true,
  "version": "0.2.0",
  "scripts": {
    "setup": "npm install && npm --prefix frontend install",
    "web:dev": "npm --prefix frontend run dev",
    "web:build": "npm --prefix frontend run build",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "android:init": "tauri android init",
    "android:dev": "tauri android dev",
    "android:build": "tauri android build --target aarch64 armv7 --apk --aab"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2"
  },
  "description": "A quiet, lightweight, community-first IDE developed by XySpace",
  "author": "XySpace and Karat contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xykalnotkel/karat-IDE.git"
  },
  "homepage": "https://github.com/xykalnotkel/karat-IDE#readme",
  "bugs": {
    "url": "https://github.com/xykalnotkel/karat-IDE/issues"
  }
}
