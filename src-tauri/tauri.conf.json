{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Karat",
  "version": "0.2.0",
  "identifier": "com.karat.ide",
  "build": {
    "frontendDist": "../frontend/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev --prefix frontend",
    "beforeBuildCommand": "npm run build --prefix frontend"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Karat",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https://ipc.localhost ws: wss:; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico", "icons/icon.png", "icons/icon.icns"],
    "category": "DeveloperTool",
    "shortDescription": "A quiet, lightweight IDE by XySpace",
    "longDescription": "Karat by XySpace is an offline-capable, community-first IDE built with Rust and Tauri.",
    "windows": {
      "nsis": {
        "languages": ["English"],
        "displayLanguageSelector": false,
        "installMode": "currentUser"
      },
      "wix": {
        "language": "en-US"
      },
      "webviewInstallMode": {
        "type": "offlineInstaller"
      }
    }
  }
}
